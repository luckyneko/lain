# A library's GLSL, compiled to SPIR-V at build time and embedded in the library, so it carries its
# own shaders and no .spv file has to be staged beside an executable that links it.
#
#   lain_embed_shaders(<target> NAMESPACE <namespace> SHADERS <shader>...)
#
# compiles each shader (a path relative to the calling CMakeLists, named <stem>.<stage>) and adds a
# generated source to <target> defining, in <namespace>, one function per shader returning its
# SPIR-V as acm::Device::createShader takes it:
#
#   const std::vector<char>& sceneVert(); // scene.vert
#
# declared in the generated header <target>shaders.h, on the target's private include path.
#
# The compiler is archimedes' (its addGlslang.cmake: a system glslc or glslang, else glslang built
# from source), so lain pins no second one. It is a build tool: nothing of it is linked or shipped,
# and the SPIR-V it writes is lain's.

include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/../extern/archimedes/cmake/addGlslang.cmake")

set(_LAIN_EMBED_SPIRV_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/lainEmbedSpirv.cmake")

# scene.vert -> sceneVert, lines.frag -> linesFrag.
function(_lain_shader_function out shader)
	get_filename_component(_name "${shader}" NAME)
	string(REPLACE "." ";" _parts "${_name}")
	list(GET _parts 0 _stem)
	list(GET _parts 1 _stage)
	string(SUBSTRING "${_stage}" 0 1 _first)
	string(TOUPPER "${_first}" _first)
	string(SUBSTRING "${_stage}" 1 -1 _rest)
	set(${out} "${_stem}${_first}${_rest}" PARENT_SCOPE)
endfunction()

function(lain_embed_shaders target)
	cmake_parse_arguments(PARSE_ARGV 1 _arg "" "NAMESPACE" "SHADERS")
	if(NOT _arg_NAMESPACE OR NOT _arg_SHADERS)
		message(FATAL_ERROR "lain_embed_shaders(${target}): NAMESPACE and SHADERS are required")
	endif()

	# glslc spells the environment as one argument and glslang as two.
	if(ACM_GLSL_COMPILER_FLAG STREQUAL "")
		set(_env "--target-env=vulkan1.3")
	else()
		set(_env --target-env vulkan1.3)
	endif()

	set(_dir "${CMAKE_CURRENT_BINARY_DIR}/shaders")
	set(_spvs "")
	set(_functions "")
	set(_declarations "")
	foreach(_shader IN LISTS _arg_SHADERS)
		get_filename_component(_name "${_shader}" NAME)
		set(_spv "${_dir}/${_name}.spv")
		add_custom_command(
			OUTPUT "${_spv}"
			COMMAND ${CMAKE_COMMAND} -E make_directory "${_dir}"
			COMMAND ${ACM_GLSL_COMPILER} ${ACM_GLSL_COMPILER_FLAG} ${_env} "${CMAKE_CURRENT_SOURCE_DIR}/${_shader}" -o "${_spv}"
			DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${_shader}"
			COMMENT "Compiling shader ${_name}"
			VERBATIM)
		_lain_shader_function(_function "${_shader}")
		list(APPEND _spvs "${_spv}")
		list(APPEND _functions "${_function}")
		string(APPEND _declarations "\tconst std::vector<char>& ${_function}(); // ${_name}\n")
	endforeach()

	# The header is known at configure time; the source needs the compiled bytes.
	set(_header "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}shaders.h")
	set(_source "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}shaders.cpp")
	file(CONFIGURE OUTPUT "${_header}" CONTENT
"#pragma once
// Generated by cmake/lainShaders.cmake: the SPIR-V of ${target}'s shaders. Do not edit.

#include <vector>

namespace ${_arg_NAMESPACE}
{
${_declarations}} // namespace ${_arg_NAMESPACE}
")

	string(REPLACE ";" "|" _spv_arg "${_spvs}")
	string(REPLACE ";" "|" _function_arg "${_functions}")
	add_custom_command(
		OUTPUT "${_source}"
		COMMAND ${CMAKE_COMMAND} "-DOUTPUT=${_source}" "-DHEADER=${target}shaders.h" "-DNAMESPACE=${_arg_NAMESPACE}"
			"-DSPIRV=${_spv_arg}" "-DFUNCTIONS=${_function_arg}" -P "${_LAIN_EMBED_SPIRV_SCRIPT}"
		DEPENDS ${_spvs} "${_LAIN_EMBED_SPIRV_SCRIPT}"
		COMMENT "Embedding ${target}'s shaders"
		VERBATIM)

	target_sources(${target} PRIVATE "${_source}")
	target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
endfunction()
