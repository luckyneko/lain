# Script mode, run by lain_embed_shaders (lainShaders.cmake) at build time: writes a C++ source
# holding each compiled shader's bytes. Inputs, '|'-separated where there are several:
#   OUTPUT     the source to write
#   HEADER     the generated header it includes
#   NAMESPACE  the namespace the functions live in
#   SPIRV      the compiled shaders
#   FUNCTIONS  one function name per shader, in the same order

string(REPLACE "|" ";" _spvs "${SPIRV}")
string(REPLACE "|" ";" _functions "${FUNCTIONS}")

set(_body "")
foreach(_spv _function IN ZIP_LISTS _spvs _functions)
	file(READ "${_spv}" _hex HEX)
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
	# 16 bytes a line, so a diff of the generated file stays readable.
	string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n\t\t\t" _bytes "${_bytes}")
	get_filename_component(_name "${_spv}" NAME)
	string(APPEND _body
"	const std::vector<char>& ${_function}()
	{
		// ${_name}
		static const unsigned char bytes[] = {
			${_bytes}
		};
		static const std::vector<char> spirv(reinterpret_cast<const char*>(bytes),
											 reinterpret_cast<const char*>(bytes) + sizeof(bytes));
		return spirv;
	}

")
endforeach()

file(WRITE "${OUTPUT}"
"// Generated by cmake/lainEmbedSpirv.cmake from compiled shaders. Do not edit.

#include \"${HEADER}\"

namespace ${NAMESPACE}
{
${_body}} // namespace ${NAMESPACE}
")
